// ADCET Alumni Portal — Prisma schema
// Source of truth for DB structure. Keep in sync with backend/openapi.yaml.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum AppRole {
  ALUMNI
  STUDENT
  ADMIN
  RECRUITER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// ADCET awards these two only. PHD/DIPLOMA existed in earlier releases and
/// were dropped by migration `signup_required_fields` (no rows used them).
enum DegreeType {
  BE
  ME
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum RsvpStatus {
  GOING
  INTERESTED
  NOT_GOING
}

enum EmailRsvpStatus {
  YES
  NO
  NOT_SURE
  MAYBE
}

enum PostMediaType {
  IMAGE
  VIDEO
}

enum PostReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum DonationStatus {
  PLEDGED
  RECEIVED
  CANCELLED
}

// =====================================================================
// CORE: Users, Roles, Profiles
// =====================================================================

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String?        // null when only OAuth login
  firstName       String
  lastName        String
  status          ApprovalStatus @default(PENDING)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  roles           UserRole[]
  profile         Profile?
  rejectionReason String?
  preferences     UserPreferences?
  refreshTokens   RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts   OAuthAccount[]

  // Authored content
  eventsCreated   Event[]        @relation("EventCreator")
  jobsCreated     Job[]          @relation("JobCreator")
  achievements    Achievement[]
  donations       Donation[]
  donationLedgerEntries DonationLedgerEntry[]
  rsvps           EventRsvp[]
  jobApplications JobApplication[]

  // Feed
  posts           Post[]
  postLikes       PostLike[]
  postComments    PostComment[]
  postReports     PostReport[]

  // Chapter membership invitations (received / sent as an admin)
  chapterInvitations     ChapterInvitation[] @relation("ChapterInvitee")
  chapterInvitationsSent ChapterInvitation[] @relation("ChapterInviter")

  settingsUpdated        AppSetting[]
  postQuotaUsage         PostQuotaUsage[]

  // Alumni Collaboration (placement drives, workshops, ...)
  collaborationRequests  CollaborationRequest[] @relation("CollaborationRequester")
  collaborationReviews   CollaborationRequest[] @relation("CollaborationReviewer")

  @@index([status])
}

/// Roles live in a separate table to prevent privilege escalation via profile updates.
model UserRole {
  id     String  @id @default(uuid())
  userId String
  role   AppRole
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model OAuthAccount {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // "linkedin" | "github"
  providerId   String
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time codes emailed during sign-up to verify the address BEFORE the
/// User row is created — hence keyed by email with no user relation.
model EmailVerificationOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Profile {
  id              String      @id @default(uuid())
  userId          String      @unique
  bio             String?
  avatarKey       String?     // storage object key
  bannerKey       String?     // profile cover banner storage key
  phone           String?
  city            String?
  country         String?     @default("India")
  linkedinUrl     String?
  githubUrl       String?
  twitterUrl      String?
  websiteUrl      String?

  /// Birthday, stored as day + month only — the platform sends birthday wishes
  /// and has no use for the year, so it deliberately isn't collected.
  birthDay        Int?
  birthMonth      Int?

  // Academic
  department      String?
  degree          DegreeType?
  /// Derived at sign-up from `graduationYear` and the degree's course length
  /// (see `admissionYearFor` in config/constants.ts) — never asked for.
  admissionYear   Int?
  graduationYear  Int?
  rollNumber      String?

  // Current professional snapshot (denormalized for quick directory queries)
  currentCompany  String?
  currentRole     String?

  /// Regional chapter the alumnus belongs to. A profile is in at most one
  /// chapter at a time; switching simply repoints this column.
  chapterId       String?

  /// Resolved city centroid for the alumni map, kept in step with `city` +
  /// `country` by `resolveProfileLocation()`. Never a residential coordinate —
  /// see `GeoLocation`.
  locationId      String?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter         Chapter?          @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  location        GeoLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  experiences     WorkExperience[]
  educations      Education[]
  skills          ProfileSkill[]

  @@index([city])
  @@index([currentCompany])
  @@index([graduationYear])
  @@index([chapterId])
  @@index([locationId])
}

/// Where a city is, resolved once and reused by every profile in it.
///
/// Two things this model deliberately is **not**:
///
/// 1. **Not per-alumnus.** Profiles point at a shared row, so 50,000 alumni in
///    200 cities cost 200 geocodes, and the map aggregates with one `groupBy`
///    on `locationId` instead of geocoding anything per request.
/// 2. **Not a precise address.** `lat`/`lng` are the *city centroid* rounded to
///    `GEO_PRECISION` decimal places (see `lib/geocode.ts`), so publishing them
///    reveals only the city an alumnus already chose to list. Nothing finer than
///    a city is ever stored, and there is no field to store it in.
///
/// `slug` is the normalised `city|country` key (lower-cased, punctuation
/// stripped) that lookups go through, so "New Delhi", "new-delhi" and
/// "NEW DELHI" all resolve to one row.
model GeoLocation {
  id        String    @id @default(uuid())
  slug      String    @unique
  city      String
  state     String?
  country   String    @default("India")
  lat       Float
  lng       Float
  source    GeoSource @default(GAZETTEER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  profiles  Profile[]

  @@index([country])
}

/// Where a `GeoLocation`'s coordinates came from. `MANUAL` rows are written by
/// an admin and are never overwritten by a later geocoder run.
enum GeoSource {
  GAZETTEER
  NOMINATIM
  MANUAL
}

/// Regional alumni chapter (Pune, Mumbai, Bangalore, …).
///
/// A chapter can only be deleted while it is **empty** — no members and no
/// events. Once either exists, deleting would orphan them, so the API refuses
/// and the chapter must be archived (`isActive: false`) instead, which hides
/// it from the public page and from new invitations while keeping history.
///
/// Membership is invite-only: an admin invites an alumnus (see
/// `ChapterInvitation`) and they join once they accept.
model Chapter {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  blurb       String?
  /// Tailwind gradient classes for the public chapter card header.
  accent      String?
  city        String?
  isActive    Boolean  @default(true)

  /// Display position, ascending — the alumni office wants Pune, Mumbai,
  /// Bangalore, Global rather than alphabetical order. Sorting lives here
  /// rather than in each page so the public landing page, the member-facing
  /// list and the admin list all agree without repeating the rule. Chapters
  /// created later default to 100 and fall in after the seeded four, then
  /// alphabetically among themselves.
  sortOrder   Int      @default(100)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Profile[]
  events      Event[]
  invitations ChapterInvitation[]

  @@index([isActive])
  @@index([sortOrder])
}

enum ChapterInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  /// Withdrawn by an admin before the alumnus responded.
  CANCELLED
}

/// An admin's invitation for an alumnus to join a chapter. Membership is only
/// granted when the invitee accepts — either in the portal or via the signed
/// one-click links in the invitation email.
///
/// One row per (chapter, user): re-inviting somebody who declined resets the
/// same row to PENDING rather than piling up duplicates.
model ChapterInvitation {
  id          String                  @id @default(uuid())
  chapterId   String
  userId      String
  status      ChapterInvitationStatus @default(PENDING)
  invitedById String
  message     String?
  createdAt   DateTime                @default(now())
  respondedAt DateTime?

  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User    @relation("ChapterInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("ChapterInviter", fields: [invitedById], references: [id])

  @@unique([chapterId, userId])
  @@index([userId, status])
}

model WorkExperience {
  id          String    @id @default(uuid())
  profileId   String
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([company])
}

model Education {
  id          String    @id @default(uuid())
  profileId   String
  institution String
  degree      String
  field       String?
  startYear   Int
  endYear     Int?
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String         @id @default(uuid())
  name     String         @unique
  profiles ProfileSkill[]
}

model ProfileSkill {
  profileId String
  skillId   String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

/// How many feed posts a member has *published* in a given month.
///
/// Deliberately separate from the `Post` table: counting live posts would give
/// the slot back when one is deleted, letting the monthly cap be side-stepped
/// by posting and deleting in a loop. This counter only ever increments, so a
/// post spends its slot for the month even if it is removed a minute later.
///
/// `period` is a "YYYY-MM" key in server local time — the same month boundary
/// `feed.service.ts` uses for the reset date.
model PostQuotaUsage {
  userId    String
  period    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, period])
}

/// Admin-tunable application settings, one row per key.
///
/// Deliberately sparse: a key is written only once an admin changes it away
/// from the default, so `lib/settings.ts` — not the database — is the source
/// of truth for defaults, and a missing row is normal rather than an error.
/// Values are JSON-encoded and parsed back through each key's Zod schema.
model AppSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model UserPreferences {
  userId               String  @id
  notificationsEmail   Boolean @default(true)
  notificationsPush    Boolean @default(true)
  darkMode             Boolean @default(false)
  language             String  @default("en")
  theme                String  @default("default") // "default"|"ocean"|"sunset"|"forest"|"royal"
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================================
// EVENTS
// =====================================================================

model Event {
  id              String         @id @default(uuid())
  title           String
  description     String
  location        String?
  isOnline        Boolean        @default(false)
  meetingUrl      String?
  startsAt        DateTime
  endsAt          DateTime?
  capacity        Int?
  coverKey        String?
  attachmentKey   String?        // PDF/image/doc attachment storage key
  /// Target departments for notifications. **Empty = every department** — an
  /// event can be aimed at any number of them, so this is a list rather than
  /// the single nullable column it replaced.
  departments     String[]       @default([])
  chapterId       String?        // Target chapter for notifications (null = all chapters)
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy   User           @relation("EventCreator", fields: [createdById], references: [id])
  chapter     Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  rsvps       EventRsvp[]

  @@index([status, startsAt])
  @@index([chapterId])
}

model EventRsvp {
  id              String           @id @default(uuid())
  eventId         String
  userId          String
  status          RsvpStatus       @default(GOING)
  emailRsvpStatus EmailRsvpStatus? // RSVP submitted via email link
  createdAt       DateTime         @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// =====================================================================
// JOBS
// =====================================================================

model Job {
  id              String         @id @default(uuid())
  title           String
  company         String
  location        String?
  isRemote        Boolean        @default(false)
  employmentType  EmploymentType @default(FULL_TIME)
  experienceMin   Int?           // years
  experienceMax   Int?
  salaryMin       Int?
  salaryMax       Int?
  currency        String         @default("INR")
  description     String
  attachmentKey   String?        // PDF/image/doc attachment storage key
  /// Departments this opening is aimed at. **Empty = open to all.**
  departments     String[]       @default([])
  requirements    String?
  vacancies       Int            @default(1)
  positionsFilled Int            @default(0)
  applyUrl        String?
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  expiresAt       DateTime?
  isClosed        Boolean        @default(false)
  closedAt        DateTime?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy       User             @relation("JobCreator", fields: [createdById], references: [id])
  applications    JobApplication[]

  @@index([status, createdAt])
  @@index([company])
}

model JobApplication {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  resumeKey String?
  coverLetter String?
  createdAt DateTime @default(now())
  resumeDeletedAt DateTime?

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
}

// =====================================================================
// ACHIEVEMENTS
// =====================================================================

model Achievement {
  id          String         @id @default(uuid())
  userId      String
  title       String
  description String
  category    String?        // "Award", "Promotion", "Publication", ...
  occurredOn  DateTime?
  imageKey    String?        // Cover image (shown in cards / home slider)
  attachmentKey String?      // Certificate / supporting doc (pdf/doc/image)
  link        String?        // External link (article, certificate URL, ...)
  status      ApprovalStatus @default(PENDING)
  rejectionReason String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// =====================================================================
// DONATIONS
// =====================================================================

model DonationCampaign {
  id          String     @id @default(uuid())
  title       String
  description String
  goalAmount  Int
  currency    String     @default("INR")
  coverKey    String?
  startsAt    DateTime
  endsAt      DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  donations   Donation[]
}

model Donation {
  id           String         @id @default(uuid())
  campaignId   String?
  userId       String
  amount       Int
  currency     String         @default("INR")
  message      String?
  status       DonationStatus @default(PLEDGED)
  proofKey      String?
  receiptKey   String?
  isAnonymous  Boolean        @default(false)
  createdAt    DateTime       @default(now())

  // Snapshot of the donor at time of donation — records stay correct even if
  // the user later edits their profile, and the receipt/email need them.
  donorName    String?
  donorEmail   String?

  // Razorpay payment tracking (backend-verified, independent of the frontend).
  provider          String?    @default("razorpay")
  razorpayOrderId   String?    @unique
  razorpayPaymentId String?
  razorpaySignature String?
  paymentMethod     String?    // upi | card | netbanking | wallet | ...
  receiptNo         String?    @unique
  paidAt            DateTime?
  receiptSentAt     DateTime?

  campaign     DonationCampaign? @relation(fields: [campaignId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  ledgerEntries DonationLedgerEntry[]

  @@index([campaignId])
  @@index([userId])
  @@index([status, createdAt])
  @@index([razorpayPaymentId])
}

model DonationLedgerEntry {
  id         String          @id @default(uuid())
  donationId String
  actorId    String?
  entryType  String
  status     DonationStatus?
  amount     Int?
  proofKey   String?
  receiptKey String?
  note       String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  donation   Donation        @relation(fields: [donationId], references: [id], onDelete: Cascade)
  actor      User?           @relation(fields: [actorId], references: [id])

  @@index([donationId, createdAt])
  @@index([actorId])
  @@index([entryType, createdAt])
}

// =====================================================================
// NOTIFICATIONS / AUDIT
// =====================================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "event.approved", "job.new", ...
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String   // "user.approve", "event.reject", ...
  entity    String   // "User" | "Event" | ...
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}
// =====================================================================
// CMS: News, Newsletters, Support inbox, Site sections
// =====================================================================

model NewsItem {
  id          String   @id @default(uuid())
  title       String
  body        String
  link        String?
  /// Short chip rendered above the headline on the public news page ("Placements", "Campus", …).
  tag         String?
  imageKey    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}

/// A published newsletter edition. `coverKey` is the first page of `fileKey`,
/// rendered client-side at upload time so the public page can show the cover
/// instead of a bare download link.
model Newsletter {
  id          String   @id @default(uuid())
  title       String
  description String?
  /// Storage key of the PDF, or a path under `public/` for the editions that
  /// predate admin uploads — `assetUrl()` on the frontend resolves both.
  fileKey     String
  coverKey    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}

/// A set of photographs from one alumni event, managed from `/admin/gallery`.
model GalleryAlbum {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  /// When the event happened — albums are listed newest first.
  eventDate   DateTime?
  location    String?
  /// Unpublished albums are invisible to the public page while being prepared.
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos GalleryPhoto[]

  @@index([isPublished, eventDate])
}

model GalleryPhoto {
  id        String   @id @default(uuid())
  albumId   String
  /// Storage key, or a path under `public/` for photos that predate uploads.
  imageKey  String
  /// Position within the album; ties break on `createdAt`.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, sortOrder])
}

model SupportMessage {
  id         String    @id @default(uuid())
  name       String
  email      String
  subject    String?
  message    String
  userId     String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
}

model SiteSection {
  /// Singleton key (e.g. "about", "contact") for static page copy.
  key       String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

// =====================================================================
// FEED: alumni-to-alumni social posts
// =====================================================================

/// A social post. Unlike Achievement/Event/Job there is no approval flow —
/// approved members publish straight to the feed; admins can remove anything.
model Post {
  id        String    @id @default(uuid())
  authorId  String
  /// Post body. Optional because a post may be media-only.
  content   String?
  /// Set the first time the author edits, so the UI can show "edited".
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media     PostMedia[]
  likes     PostLike[]
  comments  PostComment[]
  reports   PostReport[]

  @@index([createdAt])
  @@index([authorId, createdAt])
}

/// Attached image/video. Max 2 images OR 1 video per post (enforced in the
/// validator, not the DB, since the rule is cross-row).
model PostMedia {
  id        String        @id @default(uuid())
  postId    String
  /// Storage object key under the "post" upload scope.
  key       String
  type      PostMediaType
  mimeType  String?
  /// Display order within the post (0-based).
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// Member-submitted flag on a post, reviewed from the admin feed moderation page.
model PostReport {
  id         String           @id @default(uuid())
  postId     String
  reporterId String
  reason     String
  status     PostReportStatus @default(OPEN)
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())

  post       Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  /// One open report per member per post — re-reporting updates the existing row.
  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

// =====================================================================
// ALUMNI COLLABORATION
// =====================================================================

/// The kind of collaboration an alumnus is offering. Deliberately an enum on a
/// single table rather than one table per kind: every kind shares the same
/// submit → pending → admin decision lifecycle, so the admin inbox, the
/// notifications and the RBAC live in one place, and adding a kind is one
/// enum value plus its own optional columns.
enum CollaborationType {
  PLACEMENT
  WORKSHOP
}

/// How the alumnus intends to run the drive / workshop.
enum CollaborationMode {
  ON_CAMPUS
  ONLINE
  HYBRID
}

enum DurationUnit {
  HOURS
  DAYS
}

/// An alumnus's offer to collaborate with the college — run a placement drive,
/// conduct a workshop, and (later) more.
///
/// This is a **request board, not a scheduler**: approving one is the alumni
/// office saying "yes, let's talk", after which they reach the alumnus on the
/// contact details captured here. Nothing downstream (no event, no job post) is
/// created automatically.
///
/// Columns are shared where the two kinds agree and type-specific where they do
/// not; `collaboration.validators.ts` is what makes the right subset mandatory
/// per `type`, via a discriminated union.
model CollaborationRequest {
  id              String            @id @default(uuid())
  userId          String
  type            CollaborationType
  status          ApprovalStatus    @default(PENDING)
  rejectionReason String?

  // ---- shared ----
  title           String
  /// Company / institute the alumnus represents.
  organization    String?
  /// Target departments. **Empty means every department** — the same meaning
  /// `Event.departments` and `Job.departments` give an empty array.
  departments     String[]
  mode            CollaborationMode?
  /// Free-text "anything else the office should know".
  description     String?
  attachmentKey   String?
  /// Original file name, so the admin sees "jd-infosys.pdf" and not a storage key.
  attachmentName  String?
  contactEmail    String?
  contactPhone    String?

  // ---- placement only ----
  candidatesRequired Int?
  /// Role/designation offered, e.g. "Software Engineer Trainee".
  jobRole            String?
  /// CTC in lakhs per annum.
  packageLpa         Float?
  driveDate          DateTime?
  /// CGPA / backlog / batch criteria.
  eligibility        String?

  // ---- workshop only ----
  subject              String?
  durationValue        Int?
  durationUnit         DurationUnit?
  startDate            DateTime?
  endDate              DateTime?
  expectedParticipants Int?

  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User  @relation("CollaborationRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("CollaborationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// The admin inbox reads one type at one status, newest first.
  @@index([type, status, createdAt])
  /// The alumnus's own "Actions" panel reads their own requests, newest first.
  @@index([userId, createdAt])
}

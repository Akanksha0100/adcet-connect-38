# Hosts like Render set NODE_ENV=production for the build, which makes `npm ci`
# omit devDependencies — including `typescript`. The build then silently falls
# through to whatever `tsc` the platform image ships (Render's Node 24 image
# carries TypeScript 7), instead of the version pinned in package-lock.json.
# Forcing dev deps keeps the build reproducible on the compiler we test against.
include=dev

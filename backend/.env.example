# ============================================================================
# ADCET Alumni Portal — Environment Configuration
# Copy this file to `.env.development` for local dev.
# Never commit real secrets.
# ============================================================================

# === Server ===
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# === Database ===
DATABASE_URL=postgresql://adcet:adcet@localhost:5433/adcet_alumni?schema=public

# === JWT ===
JWT_ACCESS_SECRET=change-me-32-chars-minimum-secret
JWT_REFRESH_SECRET=change-me-32-chars-minimum-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# === Storage (minio | s3 | cloudinary | local) ===
STORAGE_DRIVER=minio
STORAGE_BUCKET=adcet-alumni
# Leave empty for cloudinary unless you serve from a custom CNAME.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/adcet-alumni

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=900

LOCAL_STORAGE_DIR=./uploads

# --- Cloudinary (only read when STORAGE_DRIVER=cloudinary) ---
# Paste CLOUDINARY_URL from Dashboard → API Keys, or set the three vars below.
# Also set VITE_CLOUDINARY_CLOUD_NAME in the frontend .env so it can build
# delivery URLs for the same objects.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional prefix for every object, e.g. adcet/prod — lets one cloud host
# several environments. Must match VITE_CLOUDINARY_FOLDER.
CLOUDINARY_FOLDER=
# Scopes stored as `private` assets: no public URL, only signed expiring links.
CLOUDINARY_PRIVATE_SCOPES=resume,receipt
# TTL for those signed links (Cloudinary caps signatures at 3600s).
CLOUDINARY_PRESIGN_TTL=900

# === First admin (used by `npm run seed:admin`) ===
# There is no way to create an ADMIN through the UI, so a fresh database needs
# this. Creating the account is a no-op if it already exists; the password is
# only (re)set when ADMIN_PASSWORD_FORCE=true.
ADMIN_EMAIL=admin@adcet.in
ADMIN_PASSWORD=
ADMIN_PASSWORD_FORCE=false

# === Demo alumni (also `npm run seed:admin`) ===
# Seeds two APPROVED members — alice@adcet.in and priya@adcet.in — so the
# deployed site can be tested as an ordinary alumnus, not just as the admin.
# Both share this one password. Leave it EMPTY to skip them entirely, which is
# what a real production deployment should do: these are well-known addresses
# published in the repo, so anyone who knows the password can sign in as them.
DEMO_PASSWORD=
DEMO_PASSWORD_FORCE=false

# === Email / SMTP ===
# Leave SMTP_HOST empty to use console-only transport (emails printed to terminal).
# Set SMTP_HOST to enable real SMTP delivery (e.g. Gmail, Mailtrap, etc.).
#
# HOSTING NOTE: some PaaS providers firewall outbound SMTP — Render's free tier
# blocks ports 25, 465 and 587, and port 25 is blocked on every Render plan.
# Use a relay that offers port 2525 (Brevo, Mailtrap, SendGrid) or upgrade the
# instance. Gmail only listens on 465/587, so it cannot work on a free instance.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ADCET Alumni Portal" <noreply@adcet.in>
# How long to wait on a blocked/unreachable SMTP host before giving up (ms).
SMTP_TIMEOUT_MS=15000

# TEMPORARY, TEST DEPLOYMENTS ONLY. When "true", a failed OTP email makes
# /auth/register/send-otp return the code in its JSON response instead of a 503,
# so sign-up can be completed with no working mail transport. This lets anyone
# register an email address they don't own — never enable it for real users.
EXPOSE_OTP_ON_MAIL_FAILURE=false

# === API Base URL (used in email RSVP links) ===
API_BASE_URL=http://localhost:4000/api/v1

# === OAuth / SSO ===
OAUTH_REDIRECT_BASE_URL=http://localhost:4000/api/v1/auth/oauth
OAUTH_SUCCESS_REDIRECT=http://localhost:8080/auth/callback

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Payments (Razorpay) — https://dashboard.razorpay.com/app/keys ===
# Leave empty to disable donations (order/verify endpoints return 501).
# Use rzp_test_* keys for testing; switch to rzp_live_* in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in Razorpay Dashboard → Settings → Webhooks
# (subscribe to payment.captured; point it at /api/v1/donations/webhook).
RAZORPAY_WEBHOOK_SECRET=

# Printed on donation receipts (PDF + email).
ORG_NAME=Annasaheb Dange College of Engineering & Technology, Ashta
ORG_ADDRESS=Ashta, Dist. Sangli, Maharashtra 416301

VITE_API_BASE_URL=http://localhost:4000/api/v1

# Where storage object keys are served from. Must match the backend's
# STORAGE_DRIVER — see `backend/.env.example`.
#
# minio / s3 / local: base URL that object keys hang off.
VITE_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/adcet-alumni
#
# cloudinary: leave VITE_STORAGE_PUBLIC_BASE_URL empty (unless you use a custom
# CNAME) and set the cloud name; delivery URLs are built from it. Keep
# VITE_CLOUDINARY_FOLDER in sync with the backend's CLOUDINARY_FOLDER.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_FOLDER=
